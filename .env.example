# Server-only values. Never commit .env.local or data/.
DRMZ_APP_SESSION_SECRET=
DRMZ_LEARN_DATA_DIR=./data
STRIKE_MISSIONS_DATA_DIR=./data/strike-missions
STRIKE_MISSIONS_ENABLED=true
STRIKE_MISSIONS_BUILDER_CODE=
STRIKE_MISSIONS_BLOCKFROST_PREPROD=
RESEND_API_KEY=
AUTH_MAGIC_LINK_FROM=
AUTH_MAGIC_LINK_INLINE=false
# Canonical HTTPS origin on hosted deployments.
APP_ORIGIN=
# Enable on the server; use a separate generated 32-byte encryption key.
DRMZ_LOCAL_DATA_ENCRYPTION_ENABLED=false
DRMZ_LOCAL_DATA_ENCRYPTION_KEY=
